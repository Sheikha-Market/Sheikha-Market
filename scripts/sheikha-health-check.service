[Unit]
Description=Sheikha health check and auto-restart
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Production server: /opt/sheikha/shared/.env
# Dev fallback:      /opt/sheikha/current/.env
EnvironmentFile=-/opt/sheikha/shared/.env
EnvironmentFile=-/opt/sheikha/current/.env
ExecStart=/usr/local/bin/sheikha-health-check.sh
StandardOutput=append:/var/log/sheikha-health.log
StandardError=append:/var/log/sheikha-health.log
