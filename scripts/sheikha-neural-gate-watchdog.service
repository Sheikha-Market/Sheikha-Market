[Unit]
Description=Sheikha neural gate watchdog (endpoint guard + PM2 self-healing)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PM2_HOME=/root/.pm2
Environment=HOME=/root
ExecStart=/usr/local/bin/sheikha-neural-gate-watchdog.sh

[Install]
WantedBy=multi-user.target
