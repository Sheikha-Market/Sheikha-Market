    console.log(`• فحص المرئيات (18093)       : curl http://localhost:18093/api/health`);
    console.log(`• فحص السحابة (me-central1)  : المراجعة 00013-vev مستقرة 100%`);
    break;

  case 'self-govern':
    console.log(BANNER);
    console.log(`[+] التحقق من سريان ميثاق الحوكمة الذاتي:`);
    console.log(`✓ الختم السيادي      : نافذ وملزم`);
    console.log(`✓ المنفذ 62954       : BLOCKED عمداً لمنع الغرر`);
    console.log(`✓ الترويج للإنتاج    : HOLD التزاماً بالأمانة الفنية`);
    break;

  default:
    console.log(BANNER);
    console.log(`الأوامر السيادية المتاحة:
  sheikha status                              عرض الحالة العامة ومطابقة الأقاليم
  sheikha analyze                             تحليل اتساق السجلات وتطابق المرآة
  sheikha ports                               رصد المنافذ المحلية والكبسولات
  sheikha classify [payments/contracts]       تصنيف الامتثال الشرعي للمعاملات
  sheikha expand [ai-engine/ide/foundry]      توسيع وتوثيق محركات شيخة
  sheikha decision [market/logistics]         فحص قرارات الأسواق وبوالص الشحن
  sheikha runtime                             إدارة كبسولات Podman الموزعة
  sheikha rwp                                 استعراض المقاييس النبوية والكونية
  sheikha publish-plan [file.md]              التحقق الحوكمي من خطط النشر
  sheikha smoke                               فحص جاهزية مسارات /api/health
  sheikha self-govern                         تأكيد سريان الرقابة ومكافحة الغرر`);
    break;
