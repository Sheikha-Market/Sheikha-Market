# ============================================================================
# SHEIKHA PRODUCTION ENV (Hostinger VPS - Malaysia)
# جاهز للإنتاج: انسخه إلى .env ثم عبّئ القيم السرية
# ============================================================================

# --- App Core ---
NODE_ENV=production
PORT=8080
BASE_URL=https://www.sheikha.top

# Charter / Runtime Switches
SHEIKHA_CHARTER_ENFORCED=true
STARTUP_L0_ONLY=true
MCP_DENY_BY_DEFAULT=true

# --- Contact / Identity ---
SHEIKHA_SITE_DOMAIN=www.sheikha.top
SHEIKHA_SUPPORT_EMAIL=market@sheikha.top
SHEIKHA_SUPPORT_PHONE=+966554942904

# --- Security ---
# مهم: غيّر هذا المفتاح فوراً لقيمة طويلة وعشوائية
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET

# --- Database (PostgreSQL) ---
POSTGRES_DB=sheikha_prod
POSTGRES_USER=sheikha
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://sheikha:CHANGE_ME_DB_PASSWORD@postgres:5432/sheikha_prod

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# --- MCP Policy Paths (inside container) ---
MCP_ALLOWLIST_PATH=/app/config/allowlist.json
MCP_DENYLIST_PATH=/app/config/denylist.json
MCP_POLICIES_PATH=/app/config/policies.json

# --- MCP / Hostinger Integration ---
# ضع التوكن في GitHub Secrets أو متغيرات النظام، لا تضعه في git
HOSTINGER_API_TOKEN=CHANGE_ME_HOSTINGER_TOKEN

# --- OAuth (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
NAFATH_CLIENT_ID=
NAFATH_CLIENT_SECRET=

# --- AI Providers (Optional) ---
OPENAI_API_KEY=
AI_LLM_MODEL=gpt-4o-mini
AI_LLM_BASE_URL=https://api.openai.com/v1

# --- Observability / Alerts ---
# عتبات التنبيه المقترحة
ALERT_DISK_WARNING_PERCENT=80
ALERT_DISK_CRITICAL_PERCENT=90
ALERT_RAM_WARNING_PERCENT=80
ALERT_CPU_WARNING_PERCENT=85

# Alertmanager (Webhook/Email) - اختياري
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Backup ---
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# --- Server Metadata (Reference) ---
VPS_HOST=31.97.190.74
VPS_HOSTNAME=srv949321.hstgr.cloud
VPS_REGION=Malaysia-KualaLumpur
VPS_OS=Ubuntu-24.04-LTS
VPS_PLAN=KVM4
