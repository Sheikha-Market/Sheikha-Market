النصوص_المرجعية_المكتوبة:
  مقتطف_قرآني "إن الله يأمر بالعدل والإحسان" موضعه "سورة النحل: 90"
  مقتطف_قرآني "إن الله يأمركم أن تؤدوا الأمانات إلى أهلها وإذا حكمتم بين الناس أن تحكموا بالعدل" موضعه "سورة النساء: 58"
  مقتطف_قرآني "وتعاونوا على البر والتقوى ولا تعاونوا على الإثم والعدوان" موضعه "سورة المائدة: 2"
  مقتطف_قرآني "إن جاءكم فاسق بنبإ فتبينوا أن تصيبوا قوما بجهالة" موضعه "سورة الحجرات: 6"
  مقتطف_قرآني "وأمرهم شورى بينهم" موضعه "سورة الشورى: 38"
  مقتطف_قرآني "ولا تفسدوا في الأرض بعد إصلاحها" موضعه "سورة الأعراف: 56"
  مقتطف_قرآني "تلك حدود الله فلا تعتدوها ومن يتعد حدود الله فأولئك هم الظالمون" موضعه "سورة البقرة: 229"
  مقتطف_قرآني "وتلك حدود الله ومن يتعد حدود الله فقد ظلم نفسه" موضعه "سورة الطلاق: 1"
  مقتطف_قرآني "ومن يكسب خطيئة أو إثما ثم يرم به بريئا فقد احتمل بهتانا وإثما مبينا" موضعه "سورة النساء: 112"
  مقتطف_قرآني "وما أرسلناك إلا رحمة للعالمين" موضعه "سورة الأنبياء: 107"
  مقتطف_قرآني "ولا تقف ما ليس لك به علم إن السمع والبصر والفؤاد كل أولئك كان عنه مسؤولا" موضعه "سورة الإسراء: 36"
  مقتطف_قرآني "فاسألوا أهل الذكر إن كنتم لا تعلمون" موضعه "سورة النحل: 43"
  مقتطف_قرآني "أم خلقوا من غير شيء أم هم الخالقون أم خلقوا السماوات والأرض بل لا يوقنون" موضعه "سورة الطور: 35-36"
  مقتطف_قرآني "إن في خلق السماوات والأرض واختلاف الليل والنهار لآيات لأولي الألباب" موضعه "سورة آل عمران: 190"
  مقتطف_قرآني "سنريهم آياتنا في الآفاق وفي أنفسهم حتى يتبين لهم أنه الحق أولم يكف بربك أنه على كل شيء شهيد" موضعه "سورة فصلت: 53"
  مقتطف_قرآني "لو كان فيهما آلهة إلا الله لفسدتا فسبحان الله رب العرش عما يصفون" موضعه "سورة الأنبياء: 22"
  مقتطف_قرآني "قل هو الله أحد الله الصمد لم يلد ولم يولد ولم يكن له كفوا أحد" موضعه "سورة الإخلاص: 1-4"
  مقتطف_قرآني "وما خلقت الجن والإنس إلا ليعبدون" موضعه "سورة الذاريات: 56"
  نص_من_السنة "كان الله ولم يكن شيء غيره" تخريجه "أخرجه البخاري (3191)، وصححه ابن حجر في فتح الباري (13/453)"
  نص_من_السنة "لا ضرر ولا ضرار" تخريجه "رواه أبو سعيد الخدري؛ حسنه النووي وله طرق يقوي بعضها بعضا؛ أخرجه الدارقطني والحاكم والبيهقي"

