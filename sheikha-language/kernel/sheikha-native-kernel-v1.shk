بسم_الله

مرجعية القيم_العليا:
  المصدر: القرآن_الكريم_والسنة_الصحيحة
  الإيمان: الحكم_لله_وحده
  الدور: قيم_وحدود_غير_تنفيذية
  السلطة_البرمجية: لا
  الفتوى_الآلية: ممنوعة
  المراجعة_الشرعية: أهل_العلم_المؤهلون
  التحقق_من_المصادر: واجب
  منع: ادعاء_الوحي، ادعاء_العصمة، الفتوى_الآلية، الإكراه

سياسة سلامة_النواة:
  يوجب: الصدق، العدل، الأمانة، الدليل، أقل_صلاحية، التوقف_المحكوم
  يمنع: التنفيذ_قبل_تسليم_UEFI، الضرر، الظلم، الغش، الخداع، الإكراه، تجاوز_الموافقة
  القرار_العالي_الأثر: مراجعة_بشرية_ملزمة
  التنفيذ: أقل_صلاحية_وموافقة_صريحة
  البوابة: الدليل_ثم_المراجعة_ثم_الإذن

منهج تحقق_الإقلاع:
  لغة_البرمجة: العربية
  علوم_العربية: النحو، الصرف، البلاغة، البيان
  علوم_الاستدلال: المنطق، الحجة، البرهان، الاستدلال
  منهج_الحساب: تعريفات، مسلمات، برهان، اختبار
  منهج_العلوم_التجريبية: ملاحظة، قياس، تجربة، تكرار
  الاستدلال_الشرعي: القرآن_الكريم_والسنة_الصحيحة_مع_أهل_العلم
  خلط_المجالات: ممنوع
  بيان_الدليل_والثقة: واجب
  الفتوى_الآلية: ممنوعة
  المدخل: حالة_تسليم_خدمات_UEFI
  القبول: بعد_الخروج_فقط
  الفشل: رفض_وتوقف_محكوم
  الدليل: علامة_serial_مرتبطة_ببصمة_الصورة

كيان نواة_شيخة_العربية:
  المعمارية: x86_64
  الواجهة: SHEIKHA_LANGUAGE_NATIVE_ABI_V1
  الوضع: توقف_محكوم
  الشبكة: معطلة
  الكتابة_الدائمة: معطلة

إجراء حارس_تسليم_UEFI:
  إذا خدمات_الإقلاع لم_تنته:
    ارفض "SHEIKHA_KERNEL_HANDOFF_REJECTED"
  وإلا:
    أجز "SHEIKHA_KERNEL_HANDOFF_ACCEPTED"

إجراء اختيار_وضع_النواة:
  اعرض "CONTROLLED_HALT"

إجراء تحقق_حوكمة_النواة:
  اعرض "SHEIKHA_NATIVE_GOVERNANCE_READY"
