بسم_الله
مرجعية القيم:
  المصدر: الكتاب_والسنة_الصحيحة
  الدور: قيم_غير_تنفيذية
  السلطة_البرمجية: لا
  الفتوى_الآلية: ممنوعة
  المراجعة_الشرعية: أهل_العلم_المؤهلون
  التحقق_من_المصادر: واجب
سياسة الروبوت:
  يوجب: الصدق، العدل، الأمانة، الدليل
  يمنع: الضرر، الظلم، الغش، الخداع، الإكراه
  القرار_العالي_الأثر: مراجعة_بشرية_ملزمة
  التنفيذ: أقل_صلاحية_وموافقة_صريحة
  الاتصال_بالأجهزة: ممنوع_في_المحاكاة
كيان runtime:
  الهوية: SHEIKHA_RUNTIME_V1
  النطاق: محلي_تجريبي
كيان kernel:
  الهوية: SHEIKHA_KERNEL_V1
  النطاق: إقلاع_افتراضي_معزول
كيان ufw:
  الهوية: SHEIKHA_UFW_V1
  المعنى: سياسة_جدار_ناري_افتراضية
  الافتراضي: DENY
  الاستثناء: LOCAL_DIAGNOSTIC
  التطبيق_على_الشبكة: ممنوع
إجراء تأسيس_وتحقق:
  اعرض "SHEIKHA_RUNTIME_KERNEL_UFW_LOCAL"
