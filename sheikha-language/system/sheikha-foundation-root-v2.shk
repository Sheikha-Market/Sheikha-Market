إجراء تحقق_الجذر:
  اعرض "SHEIKHA_FOUNDATION_ROOT_V2_OK"
  اعرض "SHEIKHA_LANGUAGE_FIRST_PARTY_FOUNDATION"

إجراء تحقق_الذكاء:
  اعرض "SHEIKHA_AI_ROOTS_GOVERNED_POST_BOOT"
  اعرض "الذكاء الصناعي أداة تحليل ومساعدة بلا سلطة دينية أو تنفيذ مستقل عالي الأثر"

إجراء تحقق_المحولات:
  اعرض "SHEIKHA_EXTERNAL_SYSTEMS_TOOL_ADAPTERS_ONLY"
  اعرض "Linux وWindows وmacOS أدوات تكامل وليست أساس لغة شيخة"

إجراء تحقق_الاستقلال:
  اعرض "SHEIKHA_NATIVE_MIGRATION_REQUIRED"
  اعرض "لا يكتمل الاستقلال قبل مترجم ذاتي وهدف آلي ومكتبة ونواة واختبار جهاز فعلي"
