    "key_financial_indicators": {
      "description": "المؤشرات المالية الرئيسية",
      "indicators": [
        {
          "name": "net_profit_loss",
          "label": "الربح/الخسارة الصافية",
          "formula": "الإيراد - التكاليف الكلية",
          "analysis_points": [
            "مقارنة بالسنة السابقة",
            "معدل النمو السنوي",
            "نقطة التعادل"
          ]
        },
        {
          "name": "roi_return_on_investment",
          "label": "العائد على الاستثمار (ROI)",
          "formula": "(الربح السنوي / الاستثمار الكلي) × 100",
          "target": "> 20%",
          "analysis_points": [
            "مقارنة مع معدل الفائدة البنكي",
            "مقارنة مع مشاريع بديلة",
            "فترة استرجاع الاستثمار"
          ]
        },
        {
          "name": "irr_internal_rate_return",
          "label": "معدل العائد الداخلي (IRR)",
          "formula": "معدل الخصم الذي يجعل القيمة الحالية الصافية = 0",
          "target": "> 15%",
          "analysis_points": [
            "مقارنة مع تكلفة رأس المال",
            "حساسية التغيرات"
          ]
        },
        {
          "name": "npv_net_present_value",
          "label": "القيمة الحالية الصافية (NPV)",
          "formula": "مجموع التدفقات النقدية المخصومة - الاستثمار الأولي",
          "target": "> 0",
          "analysis_points": [
            "سنة الدراسة",
            "معدل الخصم المستخدم"
          ]
        },
        {
          "name": "payback_period",
          "label": "فترة استرجاع رأس المال",
          "formula": "الاستثمار الكلي / التدفق النقدي السنوي",
          "unit": "سنة",
          "target": "< 5 سنوات",
          "analysis_points": [
            "مقارنة مع معايير الصناعة",
            "مخاطر التأخير"
          ]
        },
        {
          "name": "profit_margin",
          "label": "هامش الربح",
          "formula": "(الربح الصافي / الإيراد) × 100",
          "target": "15-25%",
          "analysis_points": [
            "مقارنة مع المنافسين",
            "اتجاه التغير"
          ]
        }
      ]
    },

    "technical_feasibility": {
      "description": "جدوى الناحية الفنية والتقنية",
      "assessment_areas": [
        {
          "area": "technology_availability",
          "label": "توفر التكنولوجيا",
          "questions": [
            "هل التكنولوجيا المطلوبة متاحة في السوق؟",
            "هل يمكن الحصول عليها محلياً أم تحتاج استيراد؟",
            "ما التكلفة والمدة الزمنية للحصول عليها؟"
          ]
        },
        {
          "area": "skill_availability",
          "label": "توفر المهارات والكفاءات",
          "questions": [
            "هل يتوفر الكادر الفني المدرب محلياً؟",
            "ما تكلفة التدريب والتطوير؟",
            "هل يمكن استقطاب الخبرات الدولية؟"
          ]
        },
        {
          "area": "infrastructure",
          "label": "البنية التحتية",
          "questions": [
            "هل الموقع يوفر الكهرباء والماء والاتصالات؟",
            "ما حالة الطرق والمواصلات؟",
            "هل يوجد ميناء أو مطار قريب؟"
          ]
        },
        {
          "area": "environmental_compliance",
          "label": "الامتثال البيئي",
          "questions": [
            "هل تتوفر معايير البيئة والسلامة؟",
            "ما الآثار البيئية المحتملة؟",
            "ما تكلفة المعالجة والحماية البيئية؟"
          ]
        },
        {
          "area": "quality_standards",
          "label": "معايير الجودة",
          "questions": [
            "هل يمكن تحقيق معايير الجودة المطلوبة؟",
            "ما الشهادات الدولية المطلوبة؟",
            "كيفية ضمان الجودة بشكل مستمر؟"
          ]
        }
      ]
    },

