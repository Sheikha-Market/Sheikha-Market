{
  "rules_version": "1.0.0",
  "engine_name": "Sheikha Administrative Logic and Management Mind Engine",
  "principles": [
    "clarity_of_roles",
    "measurable_accountability",
    "adaptive_planning",
    "evidence_based_decisions",
    "continuous_improvement"
  ],
  "entity_types": [
    "government",
    "enterprise",
    "sme",
    "community_service"
  ],
