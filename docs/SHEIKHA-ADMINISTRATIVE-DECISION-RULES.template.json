    "toolstack": ["string"],
    "recommended_methodologies": ["string"],
    "planning_horizon": "quarterly|semi_annual|annual",
    "governance_cadence": "weekly|biweekly|monthly",
    "kpi_profile": ["string"],
    "risk_profile": "string"
