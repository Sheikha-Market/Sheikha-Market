    "government": [
      "policy_and_compliance_model",
      "program_management_office",
      "cross_ministry_coordination"
    ],
    "enterprise": [
      "balanced_scorecard_model",
      "portfolio_program_project_model",
      "operational_excellence_model"
    ],
    "sme": [
      "lean_management_model",
      "okrs_execution_model",
      "cashflow_control_model"
    ],
    "community_service": [
      "impact_governance_model",
      "service_quality_model",
      "stakeholder_engagement_model"
    ]
  },
  "management_tools": {
    "planning": ["vision_map", "strategy_canvas", "roadmap_matrix"],
