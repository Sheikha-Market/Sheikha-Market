    "lean_methodology",
    "quality_management",
    "program_evaluation"
  ],
  "decision_pipeline": [
    "A0_CONTEXT_CAPTURE",
    "A1_ENTITY_AND_MATURITY_CLASSIFICATION",
    "A2_ADMIN_MODEL_SELECTION",
