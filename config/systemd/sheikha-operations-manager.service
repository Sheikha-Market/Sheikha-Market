[Unit]
Description=Sheikha local executive roles and evidence report

[Service]
Type=oneshot
ExecStart=/home/sheikha/.var/app/com.visualstudio.code/config/nvm/versions/node/v25.6.1/bin/node --jitless /home/sheikha/Projects/sheikha/sheikha-main-portal/tools/health/sheikha-operations-manager-v1.cjs --write
WorkingDirectory=/home/sheikha/Projects/sheikha/sheikha-main-portal
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sheikha/sheikha-supervisor
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
TimeoutStartSec=90s
MemoryMax=256M
CPUQuota=20%
TasksMax=32
LimitNOFILE=128
Environment=NODE_OPTIONS=

