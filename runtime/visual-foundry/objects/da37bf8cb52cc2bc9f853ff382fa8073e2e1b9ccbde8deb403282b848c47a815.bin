": "SHEIKHA-V58-MINING-009", "title": "سلاسل إمداد المعادن والرموز الجمركية", "family": "MINING", "group": "التعدين والطاقة والمصانع", "risk": "industrial_safety"}, {"id": "SHEIKHA-V58-MINING-010", "title": "الفحص المخبري وتوثيق المنشأ", "family": "MINING", "group": "التعدين والطاقة والمصانع", "risk": "industrial_safety"}, {"id": "SHEIKHA-V58-PERSONAS-001", "title": "تفضيلات المستخدم باختيار صريح", "family": "PERSONAS", "group": "التخصيص والتوائم الرقمية", "risk": "privacy_critical"}, {"id": "SHEIKHA-V58-PERSONAS-002", "title": "ملفات شخصية مستعارة وغير معرفّة", "family": "PERSONAS", "group": "التخصيص والتوائم الرقمية", "risk": "privacy_critical"}, {"id": "SHEIKHA-V58-PERSONAS-003", "title": "توأم رقمي افتراضي للتدريب", "family": "PERSONAS", "group": "التخصيص والتوائم الرقمية", "risk": "privacy_critical"}, {"id": "SHEIKHA-V58-PERSONAS-004", "title": "توأم مؤسسي بموافقة الجهة", "family": "PERSONAS", "group": "التخصيص والتوائم الرقمية", "risk": "privacy_critical"}, {"id": "SHEIKHA-V58-PERSONAS-005", "title": "توأم تجاري لسلاسل الإمداد", "family": "PERSONAS", "group": "التخصيص والتوائم الرقمية", "risk": "privacy_critical"}, {"id": "SHEIKHA-V58-PERSONAS-006", "title": "توأم قرية ومدينة من بيانات عامة", "family": "PERSONAS", "group": "التخصيص والتوائم الرقمية", "risk": "privacy_critical"}, {"id": "SHEIKHA-V58-PERSONAS-007", "title": "إلغاء الاشتراك ومحو البيانات", "family": "PERSONAS", "group": "التخصيص والتوائم الرقمية", "risk": "privacy_critical"}, {"id": "SHEIKHA-V58-PERSONAS-008", "title": "منع استنتاج السمات الحساسة", "family": "PERSONAS", "group": "التخصيص والتوائم الرقمية", "risk": "privacy_critical"}, {"id": "SHEIKHA-V58-PERSONAS-009", "title": "حماية الأطفال والبيانات الأسرية", "family": "PERSONAS", "group": "التخصيص والتوائم الرقمية", "risk": "privacy_critical"}, {"id": "SHEIKHA-V58-PERSONAS-010", "title": "مراجعة الدقة وعدم التمييز", "family": "PERSONAS", "group": "التخصيص والتوائم الرقمية", "risk": "privacy_critical"}, {"id": "SHEIKHA-V58-EDU-001", "title": "تعليم القيم بإشراف الأسرة", "family": "EDU", "group": "التعليم والتعلم عبر الأعمار", "risk": "child_safety"}, {"id": "SHEIKHA-V58-EDU-002", "title": "محتوى ما قبل المدرسة", "family": "EDU", "group": "التعليم والتعلم عبر الأعمار", "risk": "child_safety"}, {"id": "SHEIKHA-V58-EDU-003", "title": "القراءة والكتابة والحساب", "family": "EDU", "group": "التعليم والتعلم عبر الأعمار", "risk": "child_safety"}, {"id": "SHEIKHA-V58-EDU-004", "title": "التعليم المدرسي وفق المنهج", "family": "EDU", "group": "التعليم والتعلم عبر الأعمار", "risk": "child_safety"}, {"id": "SHEIKHA-V58-EDU-005", "title": "الجامعات والبحث الأكاديمي", "family": "EDU", "group": "التعليم والتعلم عبر الأعمار", "risk": "child_safety"}, {"id": "SHEIKHA-V58-EDU-006", "title": "التدريب الفني والتقني", "family": "EDU", "group": "التعليم والتعلم عبر الأعمار", "risk": "child_safety"}, {"id": "SHEIKHA-V58-EDU-007", "title": "التثقيف الشرعي الموثق", "family": "EDU", "group": "التعليم والتعلم عبر الأعمار", "risk": "child_safety"}, {"id": "SHEIKHA-V58-EDU-008", "title": "التعلم المستمر للكبار", "family": "EDU", "group": "التعليم والتعلم عبر الأعمار", "risk": "child_safety"}, {"id": "SHEIKHA-V58-EDU-009", "title": "المهارات الرقمية والسلامة", "family": "EDU", "group": "التعليم والتعلم عبر الأعمار", "risk": "child_safety"}, {"id": "SHEIKHA-V58-EDU-010", "title": "أدوات لذوي الاحتياجات الخاصة", "family": "EDU", "group": "التعليم والتعلم عبر الأعمار", "risk": "child_safety"}]; const ASSETS=[{"id": "VIS-001", "name": "Untitled(5).3png", "src": "../assets/thumbnails/asset_01.jpg", "tags": "visual_identity · concept_design · manual_review_required"}, {"id": "VIS-002", "name": "Untitled(5).jpeg", "src": "../assets/thumbnails/asset_02.jpg", "tags": "visual_identity · concept_design · manual_review_required"}, {"id": "VIS-003", "name": "Untitled(7).png", "src": "../assets/thumbnails/asset_03.jpg", "tags": "visual_identity · concept_design · manual_review_required"}, {"id": "VIS-004", "name": "Untitled(7).png 1", "src": "../assets/thumbnails/asset_04.jpg", "tags": "visual_identity · concept_design · manual_review_required"}, {"id": "VIS-005", "name": "Untitled(7).png 5", "src": "../assets/thumbnails/asset_05.jpg", "tags": "visual_identity · concept_design · manual_review_required"}, {"id": "VIS-006", "name": "Untitled(7).png2", "src": "../assets/thumbnails/asset_06.jpg", "tags": "visual_identity · concept_design · manual_review_required"}, {"id": "VIS-007", "name": "Untitled(7).png3", "src": "../assets/thumbnails/asset_07.jpg", "tags": "visual_identity · concept_design · manual_review_required"}, {"id": "VIS-008", "name": "Untitled(7).png4", "src": "../assets/thumbnails/asset_08.jpg", "tags": "visual_identity · concept_design · manual_review_required"}, {"id": "VIS-009", "name": "Untitled(7).png6", "src": "../assets/thumbnails/asset_09.jpg", "tags": "visual_identity · concept_design · manual_review_required"}, {"id": "VIS-010", "name": "Untitled(7).png9", "src": "../assets/thumbnails/asset_10.jpg", "tags": "visual_identity · concept_design · manual_review_required"}, {"id": "VIS-011", "name": "Untitled1(5).png", "src": "../assets/thumbnails/asset_11.jpg", "tags": "visual_identity · concept_design · manual_review_required"}, {"id": "VIS-012", "name": "Untitled2(5).png", "src": "../assets/thumbnails/asset_12.jpg", "tags": "visual_identity · concept_design · manual_review_required"}, {"id": "VIS-013", "name": "Untitled4(5).png", "src": "../assets/thumbnails/asset_13.jpg", "tags": "visual_identity · concept_design · manual_review_required"}, {"id": "VIS-014", "name": "شيخة_ Futuristic Coastal Innovation Campus(1)(5).png", "src": "../assets/thumbnails/asset_14.jpg", "tags": "industrial_campus · architecture · concept_design · manual_review_required"}, {"id": "VIS-015", "name": "شيخة_ منظومة حضارية ذكية متكاملة(7).png", "src": "../assets/thumbnails/asset_15.jpg", "tags": "civilization · urban_development · concept_design · manual_review_required"}];
const search=document.getElementById('search'),family=document.getElementById('family'),view=document.getElementById('weights');
const pairs=[...new Map(WEIGHTS.map(w=>[w.family,w.group])).entries()];pairs.forEach(([id,title])=>{const el=document.createElement('option');el.value=id;el.textContent=title;family.append(el)});
document.getElementById('count').textContent=WEIGHTS.length;document.getElementById('groups').textContent=pairs.length;document.getElementById('images').textContent=ASSETS.length;
let limit=36;
function render(){const q=search.value.trim().toLocaleLowerCase();const f=family.value;const selected=WEIGHTS.filter(w=>(!f||w.family===f)&&(!q||[w.id,w.title,w.group].join(' ').toLocaleLowerCase().includes(q)));
document.getElementById('shown').textContent=`${selected.length} مواصفة مطابقة — عرض ${Math.min(limit,selected.length)} منها`;
view.replaceChildren();selected.slice(0,limit).forEach(w=>{const e=document.createElement('div');e.className='item';const title=document.createElement('b');title.textContent=w.title;const grp=document.createElement('div');grp.className='chip';grp.textContent=w.group;const id=document.createElement('code');id.textContent=w.id;const st=document.createElement('div');st.className='chip';st.textContent='مرشح غير مدرب · مراجعة: '+w.risk;e.append(title,grp,id,st);view.append(e)});
document.getElementById('more').hidden=limit>=selected.length;}
search.addEventListener('input',()=>{limit=36;render()});family.addEventListener('change',()=>{limit=36;render()});document.getElementById('more').addEventListener('click',()=>{limit+=36;render()});
const av=document.getElementById('assets');ASSETS.forEach(a=>{const e=document.createElement('div');e.className='asset';const i=document.createElement('img');i.src=a.src;i.loading='lazy';i.alt='مرجع بصري رقم '+a.id;const title=document.createElement('b');title.textContent=a.id;const name=document.createElement('small');name.textContent=a.name;const tags=document.createElement('small');tags.textContent=a.tags;e.append(i,title,name,tags);av.append(e)});render();
</script></body></html>