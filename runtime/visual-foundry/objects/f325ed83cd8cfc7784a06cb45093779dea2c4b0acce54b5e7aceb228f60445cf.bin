        @import url('https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=IBM+Plex+Mono:wght@400;600&family=Tajawal:wght@400;700&display=swap');
        :root{
          --bg:#0a1f14;
          --bg-2:#0f2e1c;
          --gold:#d4af37;
          --gold-2:#f0d87a;
          --glass: rgba(255,255,255,0.06);
          --glass-border: rgba(212,175,55,0.18);
          --text-muted: #a8b5a0;
        }
        *{font-family: 'Tajawal','IBM Plex Mono', system-ui, sans-serif;}
        .mono{font-family:'IBM Plex Mono', monospace !important;}
        .amiri{font-family:'Amiri', serif !important;}
        .glass{
          background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03));
          backdrop-filter: blur(18px) saturate(140%);
          -webkit-backdrop-filter: blur(18px) saturate(140%);
          border: 1px solid var(--glass-border);
        }
        .gold-glow{ box-shadow: 0 0 30px rgba(212,175,55,0.25), inset 0 1px 0 rgba(255,255,255,0.12); }
        .droplet{
          position:absolute;
          background: radial-gradient(120% 120% at 30% 20%, rgba(255,255,255,0.9), rgba(173,216,255,0.6) 25%, rgba(91,167,255,0.15) 65%, transparent 75%);
          border-radius: 60% 40% 55% 45% / 60% 40% 60% 40%;
          filter: blur(0.2px);
          pointer-events:none;
        }
        @keyframes shimmer{
          0%{opacity:0.6; transform: translateY(0) scale(1)}
          50%{opacity:1; transform: translateY(-8px) scale(1.05)}
          100%{opacity:0.6; transform: translateY(0) scale(1)}
        }
        .scanline{
          background: linear-gradient(90deg, transparent, rgba(212,175,55,0.12), transparent);
          animation: scan 3.2s linear infinite;
        }
        @keyframes scan{0%{transform:translateX(-100%)}100%{transform:translateX(200%)}}
        ::-webkit-scrollbar{width:8px;height:8px}
        ::-webkit-scrollbar-thumb{background: #1f3d2a; border-radius: 999px}
        ::-webkit-scrollbar-track{background: #0a1f14}
