<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="تصميم هندسي تعليمي لتكامل الماء والطاقة والتربة والنبات، بسيناريوهات اصطناعية محسوبة مسبقاً من نموذج شيخة V1.">
<title>شيخة V43.82 — التصميم الهندسي للتكامل الطبيعي</title>
<style>
:root{--ink:#143c34;--muted:#61756b;--paper:#f5f3e9;--white:#fffefa;--line:#d6dfd0;--green:#164f42;--lime:#d8e6a7;--water:#4d9cb0;--gold:#b19050;--soil:#ad8b66;--air:#9ebdb9}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Tahoma,"Segoe UI",Arial,sans-serif;line-height:1.8}a{color:inherit;text-underline-offset:4px}button{font:inherit}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #be8c2c;outline-offset:5px}header,main,footer{max-width:1240px;margin:auto;padding-inline:30px}.masthead{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-block:25px;border-bottom:1px solid var(--line)}.brand{display:flex;gap:12px;align-items:center}.mark{width:36px;height:44px;background:var(--green);border-radius:50% 50% 45% 45%;display:grid;place-items:center;color:var(--lime);font-size:22px}.brand strong{font-size:23px}.brand small{display:block;font-size:10px;letter-spacing:2px;line-height:1.4}.version{font-size:11px;border:1px solid var(--line);padding:6px 13px;border-radius:40px;white-space:nowrap}.hero{padding:68px 0 46px;display:grid;grid-template-columns:1.5fr 1fr;gap:60px;align-items:end}.eyebrow{font-size:11px;letter-spacing:2px;color:var(--muted);margin:0 0 12px}.hero h1{font-size:clamp(36px,5.5vw,70px);line-height:1.25;letter-spacing:-2px;margin:0 0 22px;font-weight:500}.hero h1 span{color:#6a8f60}.hero p{max-width:640px;color:var(--muted);font-size:15px}.status-card{border-right:3px solid var(--gold);padding:5px 22px}.status-card strong{font-size:16px;display:block}.status-card p{font-size:12px;margin-bottom:0}.dot{display:inline-block;background:#77a365;width:7px;height:7px;border-radius:50%;margin-left:6px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:12px 0 20px}.section-head h2{font-size:20px;font-weight:500;margin:0}.section-head small{font-size:11px;color:var(--muted)}.scenario-switch{display:flex;gap:5px;padding:5px;border:1px solid var(--line);border-radius:10px;background:#eaeede}.scenario-switch button{border:0;background:transparent;color:var(--muted);padding:9px 18px;border-radius:7px;cursor:pointer;font-size:12px}.scenario-switch button[aria-pressed="true"]{background:var(--white);color:var(--green);box-shadow:0 2px 6px #143c3410}.landscape{background:#e8eee1;border:1px solid #cbd8c3;border-radius:18px;overflow:hidden;position:relative}.landscape-top{display:flex;justify-content:space-between;padding:22px 26px 0;gap:15px}.landscape-top strong{font-weight:500;font-size:15px}.landscape-top small{color:var(--muted);font-size:11px}.landscape svg{display:block;width:100%;height:auto}.landscape svg text{font-family:Tahoma,"Segoe UI",Arial,sans-serif}.landscape-bottom{display:flex;justify-content:space-between;gap:15px;padding:13px 25px;background:#dae3d1;font-size:11px;color:#506a5b}.lab{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(290px,1fr);gap:22px}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:12px}.metric{padding:20px;border:1px solid var(--line);border-radius:12px;background:var(--white)}.metric-label{color:var(--muted);font-size:11px}.metric-value{font-size:28px;line-height:1.7;direction:ltr;text-align:right;font-variant-numeric:tabular-nums}.metric-unit{font-size:10px;color:var(--muted);direction:ltr;text-align:right}.metric.wide{grid-column:1/-1;background:var(--green);color:#f8faef;display:flex;align-items:center;justify-content:space-between;gap:10px;padding-block:16px}.metric.wide .metric-label,.metric.wide .metric-unit{color:#cbdcc8}.metric.wide .metric-value{font-size:22px}.budget{margin-top:24px;border:1px solid var(--line);border-radius:14px;padding:24px;background:var(--white)}.budget h3{font-size:15px;font-weight:500;margin:0}.budget-line{display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:12px}.budget-line p{margin:6px 0}.bar{height:18px;display:flex;direction:ltr;border-radius:20px;overflow:hidden;background:#e8ede4;margin:18px 0}.bar span{display:block;min-width:0}.stored{background:var(--green)}.evap{background:var(--gold)}.runoff{background:var(--water)}.drain{background:var(--soil)}.legend{display:flex;flex-wrap:wrap;gap:12px 24px;font-size:11px;color:var(--muted)}.legend i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-left:7px}.equation{direction:ltr;text-align:left;background:#f0f3e9;border-radius:8px;padding:12px 16px;font-size:12px;line-height:1.7;margin-top:18px;overflow-wrap:anywhere;font-family:ui-monospace,Consolas,monospace}.support{display:grid;grid-template-columns:1fr 1fr 1fr;gap:22px;margin:42px 0}.support article{padding-top:20px;border-top:1px solid #aabca6}.support .num{color:#8c9e7b;font-size:11px;font-family:monospace}.support h3{font-size:17px;font-weight:500;margin:10px 0}.support p{font-size:12px;color:var(--muted);margin:0}.units{border-collapse:collapse;width:100%;font-size:12px}.units th,.units td{padding:11px 8px;border-bottom:1px solid var(--line);text-align:right}.units th{font-size:10px;color:var(--muted);font-weight:400}.units td:last-child{font-variant-numeric:tabular-nums}.units-wrap{border:1px solid var(--line);border-radius:14px;padding:22px;background:var(--white)}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:38px}.two-col h3{font-size:16px;font-weight:500;margin:0 0 12px}.indices{display:flex;gap:12px}.index{flex:1;background:#ecf0e1;border-radius:10px;padding:18px}.index strong{display:block;font-size:25px;font-weight:400;direction:ltr;text-align:right}.index span{font-size:11px;color:var(--muted)}.note{font-size:11px;color:var(--muted)}.values{padding:38px;border:1px solid #d7cfb5;border-radius:16px;background:#efeddf;margin:40px 0}.values blockquote{font-family:Georgia,"Times New Roman",serif;font-size:28px;margin:0 0 12px}.values p{max-width:950px;color:var(--muted);font-size:13px}.sources{display:flex;flex-wrap:wrap;gap:10px 22px;font-size:10px}.roadmap{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin:28px 0 44px}.roadmap article{border-right:2px solid var(--line);padding-right:18px}.roadmap h3{font-size:14px;font-weight:500;margin:0 0 10px}.roadmap p{font-size:12px;color:var(--muted);margin:0}.readiness{display:flex;flex-wrap:wrap;gap:10px;margin:20px 0}.readiness span{border:1px solid var(--line);padding:7px 12px;border-radius:25px;font-size:10px}.readiness .ready{background:#e0ead2;border-color:#bbcfa7}details{border-top:1px solid var(--line);padding:16px 0;font-size:12px}summary{cursor:pointer;font-size:13px}details p{color:var(--muted)}details pre{white-space:pre-wrap;overflow-wrap:anywhere;direction:ltr;text-align:left;font-size:10px;background:#e9eee2;padding:16px;border-radius:10px;max-height:420px;overflow:auto}footer{margin-top:30px;padding-block:28px 35px;border-top:1px solid var(--line);font-size:11px;color:var(--muted)}footer .footer-row{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}footer nav{display:flex;flex-wrap:wrap;gap:16px}.mono{font-family:ui-monospace,Consolas,monospace;direction:ltr;unicode-bidi:embed}.tiny{font-size:10px}.sr-only{position:absolute;clip:rect(0,0,0,0);width:1px;height:1px;overflow:hidden}
@media(max-width:850px){.hero{gap:25px;grid-template-columns:1fr;padding-top:44px}.lab,.two-col{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(4,1fr)}.metric.wide{grid-column:1/-1}.metric{padding:14px}.metric-value{font-size:23px}.support{gap:16px}.section-head{align-items:start;flex-direction:column}.landscape-top{padding:17px 20px 0}}@media(max-width:560px){header,main,footer{padding-inline:18px}.hero h1{letter-spacing:-1px}.version{font-size:9px;padding:5px 9px}.brand strong{font-size:19px}.scenario-switch{width:100%}.scenario-switch button{flex:1;padding:8px 6px}.support,.roadmap{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.metric.wide{padding:15px}.values{padding:24px}.values blockquote{font-size:24px}.landscape-bottom{font-size:9px;flex-wrap:wrap}.budget-line{flex-wrap:wrap;gap:0}.support{margin-top:32px}.units{font-size:11px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<aside id="confidentiality-banner" role="note" aria-label="إشعار السرية" style="background:#623521;color:#fff8e8;border-bottom:3px solid #c9a86e;padding:16px 24px;text-align:center;font-size:13px;font-weight:700;line-height:1.9">سري — للاستخدام الداخلي فقط. صاحب الطلب: سلمان أحمد الراجح — مؤسسة سلمان أحمد بن سلمان الراجح التجارية. شيخة: اسم تجاري مطلوب توثيقه؛ غير موثق رسمياً حالياً. يحظر النشر أو الإفصاح دون تفويض.</aside>
<header class="masthead"><div class="brand"><span class="mark" aria-hidden="true">ش</span><div><strong>شيخة</strong><small>SHEIKHA ENGINEERING</small></div></div><span class="version"><bdi>V43.82</bdi> · تصميم هندسي</span></header>
<main>
<section class="hero" aria-labelledby="page-title"><div><p class="eyebrow">مادة · طاقة · معلومات</p><h1 id="page-title">الماء يربط المشهد.<br><span>والقياس يوضح العلاقة.</span></h1><p>جزيرة، مرج، وبيئة عربية جافة. ثلاثة مشاهد نفهم بها انتقال الماء بين المطر والتربة والنبات والجريان، تحت أثر طاقة الشمس والسحاب.</p></div><aside class="status-card"><strong><span class="dot"></span>نموذج تعليمي مفترض غير معاير</strong><p>محاكاة يوم واحد؛ بيانات اصطناعية محسوبة مسبقاً من نموذج شيخة V1. اختيار السيناريو يعرض نتيجة محفوظة محلياً، بلا طلبات شبكة أو تشغيل أجهزة.</p></aside></section>
<section aria-labelledby="lab-title"><div class="section-head"><div><h2 id="lab-title">مختبر المشهد الطبيعي</h2><small>مساحة مرجعية واحدة · خطوة زمنية 1 يوم</small></div><div class="scenario-switch" role="group" aria-label="اختيار السيناريو"><button type="button" data-scenario="island" aria-pressed="false">جزيرة</button><button type="button" data-scenario="meadow" aria-pressed="true">مرج</button><button type="button" data-scenario="arabia" aria-pressed="false">بيئة عربية جافة</button></div></div>
<div class="lab"><div class="landscape"><div class="landscape-top"><strong id="scenario-label">مرج اصطناعي</strong><small>دورة مفاهيمية · الرسم غير مقياسي</small></div>
<svg viewBox="0 0 780 400" role="img" aria-labelledby="diagram-title diagram-desc"><title id="diagram-title">انتقال الماء والطاقة بين الشمس والسحاب والتربة والنبات</title><desc id="diagram-desc">الشمس تمد المشهد بالطاقة، والسحاب يخففها. المطر أو الري يضيف الماء. يتسلل جزء إلى التربة ويتحول جزء إلى جريان. يخرج الماء بالتبخر والنتح والصرف. الأشجار والثمار مؤشرات وصفية.</desc><defs><linearGradient id="sky" x2="0" y2="1"><stop stop-color="#e8eee1"/><stop offset="1" stop-color="#dce9dc"/></linearGradient><linearGradient id="ground" x2="0" y2="1"><stop stop-color="#c7bb96"/><stop offset="1" stop-color="#b59d7d"/></linearGradient><marker id="arrow-water" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 10 5 0 10" fill="none" stroke="#559bad" stroke-width="1.5"/></marker><marker id="arrow-gold" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 10 5 0 10" fill="none" stroke="#ad9755" stroke-width="1.5"/></marker></defs>
<rect width="780" height="400" fill="url(#sky)"/><circle cx="118" cy="88" r="29" fill="#d3b76c" opacity=".85"/><circle cx="118" cy="88" r="42" fill="none" stroke="#d3b76c" opacity=".3"/><g fill="none" stroke="#b79c59" stroke-width="1.6"><path d="M118 32v-9M118 153v-9M63 88h-9M181 88h-9M79 49l-7-7M157 128l7 7M157 49l7-7M79 128l-7 7"/></g><g fill="#fcfdf7" stroke="#c5d4cb"><path d="M366 93c-24-2-29-32-8-43 5-27 47-34 61-8 25-12 55 7 54 30 24 0 32 25 11 28H366Z"/><path d="M593 80c-18-2-22-23-6-31 4-20 35-25 45-6 18-9 40 5 39 22 18 0 24 18 8 21H593Z" opacity=".65"/></g>
<path d="M0 248Q110 177 232 232T454 235T780 208V400H0Z" fill="#c7d8b1"/><path d="M0 278Q129 227 264 273T535 260T780 256V400H0Z" fill="url(#ground)"/><path d="M0 273Q129 222 264 268T535 255T780 251" fill="none" stroke="#819e62" stroke-width="9"/><path d="M780 253c-97 13-150-4-193 19s-59 45-119 43-56 13-54 25" fill="none" stroke="#75acb3" stroke-width="24"/><path d="M780 251c-97 13-150-4-193 19s-59 45-119 43" fill="none" stroke="#c3ded8" stroke-width="3"/>
<g stroke="#699b6a" stroke-width="2"><path d="M70 255l-3-20m3 13 8-10M90 252l2-21m0 12 6-7M125 252l-2-16M660 245l-3-17m2 9 7-9M704 246l3-20"/></g><g><path d="M261 270l6-78 9 78" fill="#7b6850"/><path d="M268 233l-28-22m30 8 27-24" fill="none" stroke="#7b6850" stroke-width="5"/><ellipse cx="266" cy="173" rx="47" ry="41" fill="#5c8659"/><ellipse cx="238" cy="189" rx="29" ry="28" fill="#668e5c"/><ellipse cx="294" cy="189" rx="29" ry="26" fill="#507b52"/><g fill="#ccb26b"><circle cx="250" cy="177" r="4"/><circle cx="278" cy="190" r="4"/><circle cx="282" cy="157" r="4"/></g><path d="M269 276l-16 31m16-29 16 27m-16-25-1 38" stroke="#8b755b" fill="none" stroke-width="2"/></g>
<g stroke="#66a0af" stroke-width="2"><path d="M370 117l-8 20m36-15-8 20m36-17-8 20m36-20-8 20m-47 6-8 20m35-16-8 20"/></g><g fill="none" stroke-width="1.6" stroke-dasharray="5 5"><path d="M153 118q31 48 52 64" stroke="#ad9755" marker-end="url(#arrow-gold)"/><path d="M400 204v94" stroke="#559bad" marker-end="url(#arrow-water)"/><path d="M322 198q26-46 4-82" stroke="#ad9755" marker-end="url(#arrow-gold)"/><path d="M449 268q32 4 59 8" stroke="#559bad" marker-end="url(#arrow-water)"/><path d="M380 326v42" stroke="#559bad" marker-end="url(#arrow-water)"/></g>
<g fill="#35574b" font-size="12" text-anchor="middle"><text x="116" y="176">شمس</text><text x="431" y="33">سحاب</text><text x="465" y="158">مطر · mm/day</text><text x="215" y="122">طاقة · MJ/m²/day</text><text x="307" y="96">تبخر ونتح</text><text x="266" y="126">شجرة وثمر</text><text x="416" y="236">تسلل</text><text x="577" y="228">جريان نحو الأنهار</text><text x="420" y="367">صرف</text><text x="168" y="345">تربة · مخزون mm</text></g></svg>
<div class="landscape-bottom"><span>السحاب مُدخل؛ تكوّن المطر غير محسوب.</span><span>الجريان مكافئ مساحي، وليس تصريف نهر مقاساً.</span></div></div>
<div class="metrics" aria-live="polite" aria-atomic="true"><div class="metric"><div class="metric-label">الماء الوارد: مطر + ري</div><div class="metric-value" id="metric-input">—</div><div class="metric-unit">mm / day</div></div><div class="metric"><div class="metric-label">مخزون نهاية اليوم</div><div class="metric-value" id="metric-stored">—</div><div class="metric-unit">mm</div></div><div class="metric"><div class="metric-label">التبخر والنتح الفعلي</div><div class="metric-value" id="metric-et">—</div><div class="metric-unit">mm / day</div></div><div class="metric"><div class="metric-label">الجريان السطحي</div><div class="metric-value" id="metric-runoff">—</div><div class="metric-unit">mm / day</div></div><div class="metric wide"><div><div class="metric-label">الطاقة الشمسية الفعالة</div><div class="metric-unit">MJ / m² / day</div></div><div class="metric-value" id="metric-solar">—</div></div></div></div>
<div class="budget" id="conservation"><div class="budget-line"><h3>أين ذهب الماء؟</h3><p><span class="dot"></span><span id="conservation-state">جارٍ عرض النتيجة المحفوظة</span></p></div><p class="note">توزيع مخزون البداية والماء الوارد بين المخزون النهائي والتدفقات الخارجة. التسلل انتقال داخلي لا يضاف مرتين.</p><div class="bar" role="img" aria-label="توزيع الماء في نهاية اليوم"><span id="bar-stored" class="stored"></span><span id="bar-et" class="evap"></span><span id="bar-runoff" class="runoff"></span><span id="bar-drain" class="drain"></span></div><div class="legend"><span><i class="stored"></i>مخزون نهائي</span><span><i class="evap"></i>تبخر ونتح</span><span><i class="runoff"></i>جريان</span><span><i class="drain"></i>صرف</span></div><div class="equation" id="balance-equation">S₀ + P + I = S₁ + ET + Q + D</div><p class="note">متبقي الميزانية <bdi class="mono" id="residual">—</bdi> mm؛ التسامح العددي <bdi class="mono" id="tolerance">—</bdi> mm. حفظ الماء يثبت اتساق الحساب، ولا يثبت دقة تنبؤ طبيعي.</p></div>
<noscript><p>تحتاج لوحة اختيار النتائج إلى JavaScript محلي. يبقى الرسم والوحدات والفرضيات والمراجع متاحة؛ الصفحة لا تجلب بيانات خارجية.</p></noscript>
</section>
<div class="support"><article><span class="num">01 / المادة</span><h3>الماء محفوظ في حدود الوحدة</h3><p>يدخل المطر والري أولاً. تحد السعة والتسلل من التخزين، ثم يخرج الماء بالتبخر والنتح والصرف. تمثل التربة مخزوناً، لا مصنعاً للماء.</p></article><article><span class="num">02 / الطاقة</span><h3>الشمس مُدخل محدود</h3><p>إشعاع مرجعي اصطناعي قبل السحاب. يتحول إلى طلب تبخر بمعامل توضيحي غير معاير؛ لم تُغلق ميزانية طاقة أو حرارة كاملة.</p></article><article><span class="num">03 / المعلومات</span><h3>كل قيمة معها وحدتها</h3><p>التكامل المستقبلي عبر APIs يحتاج معرف موقع ومساحة ومصدر ووقت وجودة وترخيص. لم تربط هذه الصفحة خدمات أو دولاً أو مستشعرات.</p></article></div>
<section class="two-col" aria-label="مدخلات السيناريو ومؤشرات النبات"><div class="units-wrap"><h3>مدخلات السيناريو المختار</h3><table class="units"><thead><tr><th scope="col">المتغير</th><th scope="col">القيمة والوحدة</th></tr></thead><tbody id="inputs-table"></tbody></table></div><div class="units-wrap"><h3>مؤشرات النبات</h3><div class="indices"><div class="index"><strong id="growth-index">—</strong><span>مؤشر النمو · 0–1</span></div><div class="index"><strong id="fruit-index">—</strong><span>مؤشر الثمار · 0–1</span></div></div><p class="note">مؤشرات وصفية للماء والضوء والغطاء النباتي. لا تمثل kg ثمار أو كتلة حيوية أو توصية ري أو تنبؤ محصول.</p><table class="units"><tbody><tr><td>التسلل الداخلي</td><td id="infiltration-value">—</td></tr><tr><td>الصرف</td><td id="drainage-value">—</td></tr><tr><td>مؤشر الإجهاد المائي</td><td id="stress-value">—</td></tr></tbody></table><p class="note">جميع السيناريوهات مؤلفة لأغراض الشرح. اسم «البيئة العربية» لا يحدد موقعاً مرصوداً ولا يتنبأ بتكوّن أنهار.</p></div></section>
<section class="values" aria-labelledby="values-title"><p class="eyebrow" id="values-title">مرجعية قيمية · منفصلة عن القياسات الفيزيائية</p><blockquote>«وجعلنا من الماء كل شيء حي»</blockquote><p>الأنبياء: 30. الأمانة والعدل والإحسان وصون الماء والغرس قيم ترشد التصميم. والاقتداء بالنبي ﷺ في سنته وسيرته وبالخلفاء الراشدين مرجعية أخلاقية وتاريخية موثقة؛ لا تتحول النصوص إلى معاملات فيزيائية أو بيانات بيولوجية. هذه الصفحة لا تقدم فتاوى أو شهادة امتثال آلية.</p><div class="sources"><a href="https://quran.ksu.edu.sa/tafseer/katheer/sura21-aya30.html" rel="noreferrer">الآية · جامعة الملك سعود</a><a href="https://quran.ksu.edu.sa/tafseer/katheer/sura4-aya58.html" rel="noreferrer">الأمانة والعدل</a><a href="https://quran.ksu.edu.sa/tafseer/katheer/sura28-aya77.html" rel="noreferrer">الإحسان وصون الأرض</a><a href="https://sunnah.com/bukhari:2320" rel="noreferrer">فضل الغرس · البخاري 2320</a><a href="https://sunnah.com/abudawud:4607" rel="noreferrer">السنة والخلفاء · أبو داود 4607</a></div><p class="tiny">المراجع روابط اختيارية للقارئ؛ لا تحمّل الصفحة منها أي ملفات أو بيانات تلقائياً.</p></section>
<section aria-labelledby="roadmap-title"><div class="section-head"><h2 id="roadmap-title">من نموذج أرضي إلى دراسة موائل مغلقة</h2><small>خارطة طريق بحثية</small></div><div class="roadmap"><article><h3>١. قياس ومعايرة أرضية</h3><p>بيانات موثقة ومستقلة للتحقق، مع تقدير عدم اليقين وحدود الانتقال بين الأقاليم.</p></article><article><h3>٢. ميزانيات إضافية</h3><p>وحدات منفصلة للطاقة والحرارة والكربون والهواء والمغذيات، لكل منها قانون حفظ ووحدات واختبارات.</p></article><article><h3>٣. دراسة فضائية تخصصية</h3><p>محاكاة ومختبر لشروط الجاذبية والإشعاع والضغط والسلامة. لا يثبت النموذج الحالي إعماراً فضائياً أو تشغيلاً فعلياً.</p></article></div></section>
<section id="readiness" aria-labelledby="readiness-title"><h2 id="readiness-title" style="font-size:20px;font-weight:500">الجاهزية والدليل</h2><div class="readiness"><span class="ready">محاكاة محلية حتمية</span><span class="ready">اختبارات النموذج: 8 / 8</span><span class="ready">حفظ الماء: تسلسل 366 يوماً</span><span>معايرة ميدانية: غير منفذة</span><span>تكامل خارجي وأجهزة: غير مفعلة</span></div><p class="note">التحقق المذكور محلي ومحدد بالنموذج واختباراته. لقطة النتائج مضمّنة في هذا الملف؛ اختيار السيناريو لا يعيد تنفيذ النموذج في المتصفح. النشر والاستضافة لهما دليل مستقل.</p></section>
<details id="assumptions"><summary>الفرضيات وحدود النموذج</summary><p>خطوة يوم واحد فوق مساحة موحدة. التسلسل: دخول الماء، التسلل المحدود، التبخر والنتح، ثم الصرف. لا محاكاة لتكوّن السحاب أو المطر، ولا توجيه أنهار أو أملاح أو مياه جوفية أو سلاسل غذاء. معامل الطاقة تجريبي؛ النمو والثمار مؤشرات تعليمية. جميع المخرجات اصطناعية وغير معايرة.</p><p class="equation">S₁ = S₀ + P + I − ET − Q − D &nbsp; [mm per 1-day step]</p></details>
<details id="engineering-spec"><summary>الوثيقة الهندسية والمراجع العلمية</summary><p>المواصفة: <bdi class="mono">SHEIKHA-NATURAL-INTEGRATION-ENGINEERING-V1.md</bdi>. تتضمن المخطط، معادلات التسلل والصرف، عقد تبادل البيانات والحدود والقيم وخارطة الطريق.</p><p><a href="data:text/markdown;charset=utf-8,%23%20%D9%87%D9%86%D8%AF%D8%B3%D8%A9%20%D8%A7%D9%84%D8%AA%D9%83%D8%A7%D9%85%D9%84%20%D8%A7%D9%84%D8%B7%D8%A8%D9%8A%D8%B9%D9%8A%20%D9%81%D9%8A%20%D8%B4%D9%8A%D8%AE%D8%A9%20%E2%80%94%20V1%0A%0A%2A%2A%D8%A7%D9%84%D8%AA%D8%A7%D8%B1%D9%8A%D8%AE%3A%2A%2A%202026-10-22.%20%2A%2A%D8%A7%D9%84%D9%86%D8%B7%D8%A7%D9%82%3A%2A%2A%20%D9%85%D9%88%D8%A7%D8%B5%D9%81%D8%A9%20%D9%86%D9%85%D9%88%D8%B0%D8%AC%20%D8%AA%D8%B9%D9%84%D9%8A%D9%85%D9%8A%20%D8%A7%D8%B5%D8%B7%D9%86%D8%A7%D8%B9%D9%8A%20%D9%84%D9%8A%D9%88%D9%85%20%D9%88%D8%A7%D8%AD%D8%AF%D8%8C%20%D9%85%D8%B9%20%D8%B9%D9%82%D8%AF%20%D9%85%D8%B3%D8%AA%D9%82%D8%A8%D9%84%D9%8A%20%D9%84%D8%AA%D8%A8%D8%A7%D8%AF%D9%84%20%D8%A8%D9%8A%D8%A7%D9%86%D8%A7%D8%AA%20%D8%A7%D9%84%D8%B1%D8%B5%D8%AF.%20%D8%A7%D9%84%D8%AA%D9%86%D9%81%D9%8A%D8%B0%20%D9%81%D9%8A%20%60runtime%2Fsheikha-natural-integration%2Fv1%2F%60%D8%9B%20%D9%84%D8%A7%20%D8%AA%D9%8F%D8%AB%D8%A8%D8%AA%20%D8%A7%D9%84%D8%B3%D9%8A%D9%86%D8%A7%D8%B1%D9%8A%D9%88%D9%87%D8%A7%D8%AA%20%D8%A7%D8%AA%D8%B5%D8%A7%D9%84%D8%A7%D9%8B%20%D8%A8%D9%85%D8%B3%D8%AA%D8%B4%D8%B9%D8%B1%D8%A7%D8%AA%20%D8%A3%D9%88%20%D8%B4%D8%B1%D8%A7%D9%83%D8%A9%20%D8%AF%D9%88%D9%84%D9%8A%D8%A9%20%D8%A3%D9%88%20%D8%AA%D8%B4%D8%BA%D9%8A%D9%84%D8%A7%D9%8B%20%D9%85%D9%8A%D8%AF%D8%A7%D9%86%D9%8A%D8%A7%D9%8B.%0A%0A%23%23%20%D8%A7%D9%84%D9%85%D8%A7%D8%AF%D8%A9%20%D9%88%D8%A7%D9%84%D8%B7%D8%A7%D9%82%D8%A9%20%D9%88%D8%A7%D9%84%D9%85%D8%B9%D9%84%D9%88%D9%85%D8%A7%D8%AA%0A%0A%D8%AA%D9%8F%D9%85%D8%AB%D9%91%D9%84%20%D8%A7%D9%84%D8%AC%D8%B2%D9%8A%D8%B1%D8%A9%20%D9%88%D8%A7%D9%84%D9%85%D8%B1%D8%AC%20%D9%88%D8%A7%D9%84%D8%AC%D8%B2%D9%8A%D8%B1%D8%A9%20%D8%A7%D9%84%D8%B9%D8%B1%D8%A8%D9%8A%D8%A9%20%D9%88%D8%AD%D8%AF%D8%A7%D8%AA%20%D9%85%D9%83%D8%A7%