<script id="precomputed-model-results" type="application/json">{"model": {"id": "SHEIKHA_NATURAL_INTEGRATION_MODEL_V1", "schemaVersion": "1.0", "kind": "SYNTHETIC_DAILY_BUCKET_MODEL", "timeStepDays": 1, "status": "LOCAL_SIMULATION", "inputSchema": {"scenario": {"allowed": ["island", "meadow", "arabia"], "default": "meadow"}, "numericFields": {"rainMm": {"min": 0, "max": 500, "unit": "mm/day"}, "irrigationMm": {"min": 0, "max": 500, "unit": "mm/day"}, "soilWaterMm": {"min": 0, "max": 2000, "unit": "mm"}, "soilCapacityMm": {"min": 1, "max": 2000, "unit": "mm"}, "infiltrationCapacityMmDay": {"min": 0, "max": 500, "unit": "mm/day"}, "solarMJm2Day": {"min": 0, "max": 50, "unit": "MJ/m2/day"}, "cloudFraction": {"min": 0, "max": 1, "unit": "fraction"}, "canopyFraction": {"min": 0, "max": 1, "unit": "fraction"}, "cropFactor": {"min": 0, "max": 2.5, "unit": "dimensionless"}, "fieldCapacityFraction": {"min": 0, "max": 1, "unit": "fraction"}, "drainageFraction": {"min": 0, "max": 1, "unit": "fraction/day"}, "treeCanopyFraction": {"min": 0, "max": 1, "unit": "fraction"}, "fruitingFactor": {"min": 0, "max": 1, "unit": "dimensionless"}}, "unknownFields": "REJECTED"}, "coefficients": {"cloudAttenuation": 0.65, "evaporationMmPerMJm2": 0.25, "bareSoilFactor": 0.2, "lightReferenceMJm2Day": 20}, "waterBalanceEquation": "initialSoilWaterMm + rainMm + irrigationMm = finalSoilWaterMm + evapotranspirationMm + runoffMm + drainageMm", "assumptions": ["All flows are one-day water-depth equivalents over the same unit land area.", "Rain and irrigation enter first; infiltration is limited by daily capacity and empty soil storage.", "Evapotranspiration follows infiltration; drainage follows evapotranspiration.", "Infiltration is an internal transfer, not an additional term on the balance output side.", "Runoff is routed to a river-equivalent flow; this is not river depth, discharge or channel routing.", "Solar input is synthetic clear-sky potential before the cloud attenuation heuristic.", "Growth and fruit potential are descriptive indices, not biomass, harvest, yield or forecasts.", "This model makes no claims about unseen matters, human physiology or living neural networks."], "outputUnits": {"water": "mm per one-day step over unit land area", "solar": "MJ/m2/day", "waterStressIndex": "dimensionless [0,1]; 1 means unmet modeled water demand", "growthIndex": "dimensionless [0,1]; descriptive only", "fruitPotentialIndex": "dimensionless [0,1]; descriptive only"}, "provenance": {"source": "AUTHORED_SYNTHETIC_SCENARIOS_AND_HEURISTICS", "measuredObservations": false, "calibrated": false, "validatedDigitalTwin": false, "trainedAI": false, "physicalActuation": false, "scope": "ILLUSTRATIVE_TERRESTRIAL_WATER_AND_VEGETATION_MODEL"}}, "modelSha256": "6e9f4316523551b1f3ff8a387230d3ee2dfc1a063a12438fa906db0cd267ba67", "generatedAt": "2026-10-22T08:42:42.580Z", "scenarios": {"island": {"scenario": {"id": "island", "label": "جزيرة اصطناعية", "synthetic": true, "provenance": {"source": "AUTHORED_SYNTHETIC_SCENARIOS_AND_HEURISTICS", "measuredObservations": false, "calibrated": false, "validatedDigitalTwin": false, "trainedAI": false, "physicalActuation": false, "scope": "ILLUSTRATIVE_TERRESTRIAL_WATER_AND_VEGETATION_MODEL"}, "inputs": {"scenario": "island", "rainMm": 18, "irrigationMm": 0, "soilWaterMm": 90, "soilCapacityMm": 180, "infiltrationCapacityMmDay": 60, "solarMJm2Day": 24, "cloudFraction": 0.45, "canopyFraction": 0.8, "cropFactor": 1, "fieldCapacityFraction": 0.7, "drainageFraction": 0.2, "treeCanopyFraction": 0.6, "fruitingFactor": 0.7}}, "result": {"schemaVersion": "1.0", "model": "SHEIKHA_NATURAL_INTEGRATION_MODEL_V1", "status": "LOCAL_SIMULATION", "synthetic": true, "deterministic": true, "timeStepDays": 1, "inputs": {"scenario": "island", "rainMm": 18, "irrigationMm": 0, "soilWaterMm": 90, "soilCapacityMm": 180, "infiltrationCapacityMmDay": 60, "solarMJm2Day": 24, "cloudFraction": 0.45, "canopyFraction": 0.8, "cropFactor": 1, "fieldCapacityFraction": 0.7, "drainageFraction": 0.2, "treeCanopyFraction": 0.6, "fruitingFactor": 0.7}, "solar": {"clearSkyPotentialMJm2Day": 24, "cloudFraction": 0.45, "effectiveSolarMJm2Day": 16.98}, "water": {"initialSoilWaterMm": 90, "rainMm": 18, "irrigationMm": 0, "externalInputMm": 18, "totalAvailableMm": 108, "infiltrationMm": 18, "evapotranspirationDemandMm": 3.5658000000000003, "evapotranspirationMm": 3.5658000000000003, "runoffMm": 0, "riverInflowEquivalentMm": 0, "drainageMm": 0, "finalSoilWaterMm": 104.4342, "balanceResidualMm": 0, "balanceToleranceMm": 1.08e-07, "conserved": true}, "vegetation": {"status": "DESCRIPTIVE_INDICES_ONLY", "canopyFraction": 0.8, "treeCanopyFraction": 0.6, "waterStressIndex": 0, "lightIndex": 0.849, "growthIndex": 0.6792, "fruitPotentialIndex": 0.35657999999999995, "harvestEstimated": false}, "provenance": {"source": "AUTHORED_SYNTHETIC_SCENARIOS_AND_HEURISTICS", "measuredObservations": false, "calibrated": false, "validatedDigitalTwin": false, "trainedAI": false, "physicalActuation": false, "scope": "ILLUSTRATIVE_TERRESTRIAL_WATER_AND_VEGETATION_MODEL"}}}, "meadow": {"scenario": {"id": "meadow", "label": "مرج اصطناعي", "synthetic": true, "provenance": {"source": "AUTHORED_SYNTHETIC_SCENARIOS_AND_HEURISTICS", "measuredObservations": false, "calibrated": false, "validatedDigitalTwin": false, "trainedAI": false, "physicalActuation": false, "scope": "ILLUSTRATIVE_TERRESTRIAL_WATER_AND_VEGETATION_MODEL"}, "inputs": {"scenario": "meadow", "rainMm": 6, "irrigationMm": 0, "soilWaterMm": 75, "soilCapacityMm": 140, "infiltrationCapacityMmDay": 35, "solarMJm2Day": 22, "cloudFraction": 0.35, "canopyFraction": 0.9, "cropFactor": 0.85, "fieldCapacityFraction": 0.7, "drainageFraction": 0.25, "treeCanopyFraction": 0.1, "fruitingFactor": 0.3}}, "result": {"schemaVersion": "1.0", "model": "SHEIKHA_NATURAL_INTEGRATION_MODEL_V1", "status": "LOCAL_SIMULATION", "synthetic": true, "deterministic": true, "timeStepDays": 1, "inputs": {"scenario": "meadow", "rainMm": 6, "irrigationMm": 0, "soilWaterMm": 75, "soilCapacityMm": 140, "infiltrationCapacityMmDay": 35, "solarMJm2Day": 22, "cloudFraction": 0.35, "canopyFraction": 0.9, "cropFactor": 0.85, "fieldCapacityFraction": 0.7, "drainageFraction": 0.25, "treeCanopyFraction": 0.1, "fruitingFactor": 0.3}, "solar": {"clearSkyPotentialMJm2Day": 22, "cloudFraction": 0.35, "effectiveSolarMJm2Day": 16.994999999999997}, "water": {"initialSoilWaterMm": 75, "rainMm": 6, "irrigationMm": 0, "externalInputMm": 6, "totalAvailableMm": 81, "infiltrationMm": 6, "evapotranspirationDemandMm": 3.3225225, "evapotranspirationMm": 3.3225225, "runoffMm": 0, "riverInflowEquivalentMm": 0, "drainageMm": 0, "finalSoilWaterMm": 77.6774775, "balanceResidualMm": 0, "balanceToleranceMm": 8.100000000000001e-08, "conserved": true}, "vegetation": {"status": "DESCRIPTIVE_INDICES_ONLY", "canopyFraction": 0.9, "treeCanopyFraction": 0.1, "waterStressIndex": 0, "lightIndex": 0.8497499999999999, "growthIndex": 0.6500587499999999, "fruitPotentialIndex": 0.021668624999999997, "harvestEstimated": false}, "provenance": {"source": "AUTHORED_SYNTHETIC_SCENARIOS_AND_HEURISTICS", "measuredObservations": false, "calibrated": false, "validatedDigitalTwin": false, "trainedAI": false, "physicalActuation": false, "scope": "ILLUSTRATIVE_TERRESTRIAL_WATER_AND_VEGETATION_MODEL"}}}, "arabia": {"scenario": {"id": "arabia", "label": "بيئة عربية جافة اصطناعية", "synthetic": true, "provenance": {"source": "AUTHORED_SYNTHETIC_SCENARIOS_AND_HEURISTICS", "measuredObservations": false, "calibrated": false, "validatedDigitalTwin": false, "trainedAI": false, "physicalActuation": false, "scope": "ILLUSTRATIVE_TERRESTRIAL_WATER_AND_VEGETATION_MODEL"}, "inputs": {"scenario": "arabia", "rainMm": 0.2, "irrigationMm": 0, "soilWaterMm": 15, "soilCapacityMm": 100, "infiltrationCapacityMmDay": 18, "solarMJm2Day": 30, "cloudFraction": 0.05, "canopyFraction": 0.15, "cropFactor": 0.55, "fieldCapacityFraction": 0.65, "drainageFraction": 0.15, "treeCanopyFraction": 0.05, "fruitingFactor": 0.2}}, "result": {"schemaVersion": "1.0", "model": "SHEIKHA_NATURAL_INTEGRATION_MODEL_V1", "status": "LOCAL_SIMULATION", "synthetic": true, "deterministic": true, "timeStepDays": 1, "inputs": {"scenario": "arabia", "rainMm": 0.2, "irrigationMm": 0, "soilWaterMm": 15, "soilCapacityMm": 100, "infiltrationCapacityMmDay": 18, "solarMJm2Day": 30, "cloudFraction": 0.05, "canopyFraction": 0.15, "cropFactor": 0.55, "fieldCapacityFraction": 0.65, "drainageFraction": 0.15, "treeCanopyFraction": 0.05, "fruitingFactor": 0.2}, "solar": {"clearSkyPotentialMJm2Day": 30, "cloudFraction": 0.05, "effectiveSolarMJm2Day": 29.025000000000002}, "water": {"initialSoilWaterMm": 15, "rainMm": 0.2, "irrigationMm": 0, "externalInputMm": 0.2, "totalAvailableMm": 15.2, "infiltrationMm": 0.2, "evapotranspirationDemandMm": 1.2771000000000003, "evapotranspirationMm": 1.2771000000000003, "runoffMm": 0, "riverInflowEquivalentMm": 0, "drainageMm": 0, "finalSoilWaterMm": 13.922899999999998, "balanceResidualMm": 0, "balanceToleranceMm": 1.52e-08, "conserved": true}, "vegetation": {"status": "DESCRIPTIVE_INDICES_ONLY", "canopyFraction": 0.15, "treeCanopyFraction": 0.05, "waterStressIndex": 0, "lightIndex": 1, "growthIndex": 0.0825, "fruitPotentialIndex": 0.005500000000000001, "harvestEstimated": false}, "provenance": {"source": "AUTHORED_SYNTHETIC_SCENARIOS_AND_HEURISTICS", "measuredObservations": false, "calibrated": false, "validatedDigitalTwin": false, "trainedAI": false, "physicalActuation": false, "scope": "ILLUSTRATIVE_TERRESTRIAL_WATER_AND_VEGETATION_MODEL"}}}}}</script>
<script>
'use strict';
const snapshot=JSON.parse(document.getElementById('precomputed-model-results').textContent);
const number=value=>new Intl.NumberFormat('en',{maximumFractionDigits:4}).format(value);
const text=(id,value)=>{document.getElementById(id).textContent=value;};
function showScenario(name){
 const entry=snapshot.scenarios[name]; if(!entry)return;
 const result=entry.result,water=result.water,plant=result.vegetation,inputs=result.inputs;
 document.querySelectorAll('[data-scenario]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.scenario===name)));
 text('scenario-label',entry.scenario.label);
 for(const [id,value] of [['metric-input',water.externalInputMm],['metric-stored',water.finalSoilWaterMm],['metric-et',water.evapotranspirationMm],['metric-runoff',water.runoffMm],['metric-solar',result.solar.effectiveSolarMJm2Day],['growth-index',plant.growthIndex],['fruit-index',plant.fruitPotentialIndex],['stress-value',plant.waterStressIndex]])text(id,number(value));
 text('infiltration-value',number(water.infiltrationMm)+' mm / day');text('drainage-value',number(water.drainageMm)+' mm / day');
 text('residual',String(water.balanceResidualMm));text('tolerance',String(water.balanceToleranceMm));
 text('conservation-state',water.conserved?'ميزانية الماء محفوظة حسابياً':'ميزانية تحتاج مراجعة');
 text('balance-equation',`${number(water.initialSoilWaterMm)} + ${number(water.rainMm)} + ${number(water.irrigationMm)} = ${number(water.finalSoilWaterMm)} + ${number(water.evapotranspirationMm)} + ${number(water.runoffMm)} + ${number(water.drainageMm)} mm`);
 for(const [id,value] of [['bar-stored',water.finalSoilWaterMm],['bar-et',water.evapotranspirationMm],['bar-runoff',water.runoffMm],['bar-drain',water.drainageMm]])document.getElementById(id).style.width=(water.totalAvailableMm?value/water.totalAvailableMm*100:0)+'%';
 const rows=[['المطر',inputs.rainMm,'mm/day'],['الري',inputs.irrigationMm,'mm/day'],['مخزون بداية اليوم',inputs.soilWaterMm,'mm'],['سعة مخزون التربة',inputs.soilCapacityMm,'mm'],['حد التسلل',inputs.infiltrationCapacityMmDay,'mm/day'],['إشعاع مرجعي قبل السحاب',inputs.solarMJm2Day,'MJ/m²/day'],['كسر السحاب',inputs.cloudFraction,'0–1'],['كسر الغطاء النباتي',inputs.canopyFraction,'0–1']];
 const table=document.getElementById('inputs-table');table.replaceChildren();
 rows.forEach(([label,value,unit])=>{const row=document.createElement('tr'),key=document.createElement('td'),cell=document.createElement('td'),bdi=document.createElement('bdi');key.textContent=label;bdi.textContent=number(value)+' '+unit;bdi.dir='ltr';cell.append(bdi);row.append(key,cell);table.append(row);});
}
document.querySelectorAll('[data-scenario]').forEach(button=>button.addEventListener('click',()=>showScenario(button.dataset.scenario)));
text('model-hash',snapshot.modelSha256);text('snapshot-time',snapshot.generatedAt);text('model-metadata',JSON.stringify(snapshot.model,null,2));showScenario('meadow');
</script>
</body>
</html>
