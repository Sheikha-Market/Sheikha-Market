    "storeVerifiedArabicTextOnly": true,
    "storeSourceHash": true,
    "storeHumanReviewRecord": true,
    "unverifiedTextIngestionAllowed": false
  },
  "boundaries": {
    "noDivineAuthorityClaim": true,
    "noReplacementForQualifiedScholars": true,
    "noAutonomousFatwa": true,
    "noFabricatedCitation": true,
    "noPredictionOfUnseen": true,
    "noHarm": true,
    "noInjustice": true
  }
