{
  "system": "SHEIKHA_CUSTOMER_CLASSIFICATION_V1",
  "status": "ACTIVE",
  "arabic_name": "تصنيف عملاء وسوق شيخة V1",
  "purpose": "Classify Sheikha customers, merchants, companies, governments, providers, partners, investors, and individuals into governed commercial segments that drive registration, dashboards, contracts, licensing, billing, permissions, and sales priority.",
  "position": "UNDER_PLATFORM_OPERATING_ENGINES_ABOVE_CUSTOMER_REGISTRATION",
  "based_on": [
    "SHEIKHA_ROOT_OPERATING_CORE_V1",
    "SHEIKHA_ROOT_AUTHORITY_LAYER_V1",
    "SHEIKHA_COMMERCIAL_PRODUCT_LAYER_V1",
    "SHEIKHA_COMMERCIAL_REAL_ACTIVATION_V1",
    "SHEIKHA_PLATFORM_OPERATING_ENGINES_V1"
  ],
  "classification_flow": [
    "customer_segment",
    "customer_type",
    "business_model",
    "role",
    "verification_level",
    "commercial_priority",
    "sector",
    "dashboard_route",
    "contract_gate",
    "billing_gate"
  ],
  "truthfulness": {
    "classification_is_not_contract_claim": true,
    "classification_is_not_customer_acquisition_claim": true,
    "classification_is_not_revenue_claim": true,
