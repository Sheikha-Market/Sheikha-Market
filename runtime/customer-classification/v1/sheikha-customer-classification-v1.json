    "legal_review_required_before_government_or_regulatory_offer": true
  },
  "rules": {
    "no_active_customer_without_contract_or_verified_account": true,
    "no_government_status_without_entity_evidence": true,
    "no_supplier_approval_without_commercial_and_tax_verification": true,
    "no_revenue_customer_without_paid_invoice": true,
    "role_based_dashboard_required": true,
    "verification_level_must_drive_permissions": true,
    "commercial_priority_must_drive_sales_workflow": true
  },
  "principle": "ولا حول ولا قوة إلا بالله"
}
