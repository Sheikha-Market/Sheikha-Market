{
  "system": "SHEIKHA_RUNTIME_CONTRACT_REGISTRY_OMEGA",
  "version": "1.0.0",
  "status": "ACTIVE",
  "purpose": "Define enforceable runtime contracts for master blueprint layers, validation, governance, quality, observability, and self-healing.",
  "contracts": {
    "runtime_index_contract": {
      "source": "runtime/runtime-index/sheikha-runtime-index.json",
      "required": true,
      "must_define": ["system", "version", "status", "runtime", "maturity"]
    },
    "dependency_genome_contract": {
      "source": "runtime/dependency-genome/sheikha-dependency-genome.json",
      "required": true,
      "must_define": ["system", "version", "status", "dependency_model", "contract_rules"]
    },
    "topology_graph_contract": {
      "source": "runtime/topology-graph/sheikha-topology-graph.json",
      "required": true,
      "must_define": ["system", "version", "status", "nodes", "edges", "topology_properties"]
    },
    "runtime_observatory_contract": {
      "source": "runtime/runtime-observatory/sheikha-runtime-observatory.json",
      "required": true,
      "must_define": ["system", "version", "status", "observability", "signals", "health_states"]
    },
    "master_blueprint_contract": {
      "source": "runtime/master-blueprint/sheikha-master-blueprint-engine.json",
      "required": true,
      "must_define": ["system", "version", "status", "blueprint_sources", "blueprint_layers", "architecture_controls"]
    },
    "capability_genome_contract": {
      "source": "runtime/capability-genome/sheikha-capability-genome.json",
      "required": true,
      "must_define": ["system", "version", "status", "capability_domains", "controls"]
    },
    "enterprise_dashboard_contract": {
      "source": "runtime/enterprise-dashboard/sheikha-enterprise-runtime-dashboard.json",
      "required": true,
      "must_define": ["system", "version", "status", "dashboard_sections", "enterprise_indicators"]
    }
  },
  "global_rules": {
    "all_contracts_required": true,
    "json_validation_required": true,
    "governance_verification_required": true,
    "quality_gate_required": true,
    "audit_trace_required": true,
    "self_healing_alignment_required": true
  },
  "maturity": {
    "contract_coverage": "VERY_HIGH",
    "validation_readiness": "VERY_HIGH",
    "enterprise_enforceability": "VERY_HIGH",
    "overall": "ENTERPRISE_GRADE_PLUS"
  }
}
