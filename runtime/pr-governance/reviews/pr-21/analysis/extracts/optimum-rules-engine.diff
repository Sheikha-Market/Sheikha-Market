+// تصدير المحرك
+// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
+
+let _instance = null;
+
+function getOptimumRulesEngine() {
+    if (!_instance) {
+        _instance = new OptimumRulesEngine();
+    }
+    return _instance;
+}
+
+module.exports = OptimumRulesEngine;
+module.exports.getOptimumRulesEngine = getOptimumRulesEngine;
+module.exports.OPTIMUM_RULES_DATABASE = OPTIMUM_RULES_DATABASE;
