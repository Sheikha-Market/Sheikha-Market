    "memory": "GOVERNED",
    "storage": "GOVERNED",
    "network": "GOVERNED",
    "devices": "GOVERNED",
    "drivers": "READ_ONLY_BY_DEFAULT",
    "scheduling": "GOVERNED",
    "security": "GOVERNED",
    "logs": "GOVERNED"
  },
  "high_level_layers": {
    "services": "GOVERNED",
    "applications": "GOVERNED",
