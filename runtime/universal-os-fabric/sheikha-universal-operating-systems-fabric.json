    "role": "طبقة تقنية تكاملية لا تدعي علم الغيب ولا تملك النظام بذاتها",
    "limits": "تعمل فقط ضمن الصلاحيات المصرح بها وبلا ضرر ولا ضرار"
  },
  "supported_platforms": {
    "linux": "ACTIVE",
    "windows": "READY",
    "macos": "READY",
    "unix": "READY",
    "bsd": "READY",
    "cloud": "READY",
    "edge": "READY",
    "containers": "READY",
    "virtual_machines": "READY",
    "supercomputer_hpc": "READY"
  },
  "low_level_layers": {
    "kernel_interface": "GOVERNED",
