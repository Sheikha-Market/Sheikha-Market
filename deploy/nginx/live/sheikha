server {
    location /monitor {
        alias /var/www/sheikha-monitor/;
        index index.html;
    }
    listen 80;
    listen [::]:80;
    server_name sheikha.top www.sheikha.top public.sheikha.top admin.sheikha.top;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sheikha.top www.sheikha.top;

    ssl_certificate /etc/letsencrypt/live/www.sheikha.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.sheikha.top/privkey.pem;

    location /monitor/ {
        alias /var/www/sheikha-monitor/;
        index index.html;
        try_files $uri $uri/ /monitor/index.html;
    }

    location = /monitor {
        return 301 /monitor/;
    }

    location = /api/sheikha/live/chat/v1 {
        proxy_pass http://127.0.0.1:8083;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 100s;
        proxy_read_timeout 100s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name public.sheikha.top;

    ssl_certificate /etc/letsencrypt/live/public.sheikha.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/public.sheikha.top/privkey.pem;

    location = /api/sheikha/live/chat/v1 {
        proxy_pass http://127.0.0.1:8083;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 100s;
        proxy_read_timeout 100s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.sheikha.top;

    ssl_certificate /etc/letsencrypt/live/public.sheikha.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/public.sheikha.top/privkey.pem;

    auth_basic "Sheikha Admin";
    auth_basic_user_file /etc/nginx/.sheikha_admin_htpasswd;

    location / {
        proxy_pass http://127.0.0.1:8080/admin/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
