# ─── الإعدادات الأساسية ───────────────────────────────────────────────────────
# Basic Settings

# عنوان الموقع الأساسي
BASE_URL=https://www.sheikha.top

# منفذ الخادم
PORT=8080

# بيئة التشغيل (production / development)
NODE_ENV=production

# ─── الأمان والمصادقة ─────────────────────────────────────────────────────────
# Security & Authentication

# مفتاح JWT — غيّره لقيمة عشوائية طويلة وآمنة!
# استخدم: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARACTERS_LONG_12345

# مدة صلاحية التوكن (بالثواني) — 7 أيام = 604800
JWT_EXPIRES_IN=604800

# ملح تشفير كلمات المرور — غيّره لقيمة عشوائية!
PASSWORD_SALT=CHANGE_THIS_SALT_TO_RANDOM_VALUE_987654321

# ─── معدل الطلبات (Rate Limiting) ─────────────────────────────────────────────
# Rate Limiting (للحماية من الهجمات)

# أقصى عدد طلبات في الدقيقة للمستخدم الواحد
RATE_LIMIT_MAX=100

# نافذة المعدل بالمللي ثانية (دقيقة = 60000)
RATE_LIMIT_WINDOW_MS=60000

# ─── OAuth — تسجيل الدخول الاجتماعي ───────────────────────────────────────────
# OAuth — Social Login

# جوجل — من Google Cloud Console → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# مايكروسوفت — من Azure Portal → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# أبل — من Apple Developer → Sign in with Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# نفاذ — من منصة نفاذ للمطورين
NAFATH_CLIENT_ID=
NAFATH_CLIENT_SECRET=

