{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheikha.local/schemas/sheikha-target-matrix-v2.schema.json",
  "title": "Sheikha Universal Delivery Target Matrix V2",
  "type": "object",
  "required": ["schemaVersion", "system", "version", "sourceOfTruth", "targetCount", "allowedStatuses", "targets"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "system": { "const": "SHEIKHA_UNIVERSAL_DELIVERY_DISTRIBUTION_INSTALLER_FABRIC_V2" },
    "version": { "type": "string", "minLength": 1 },
    "sourceOfTruth": { "const": true },
    "targetCount": { "const": 27 },
    "allowedStatuses": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "targets": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "type": "object",
        "required": [
          "id", "product", "platform", "operatingSystem", "architecture", "format",
          "installationScope", "runtimeType", "buildStrategy", "buildHostRequirement",
          "nativeRunnerRequirement", "signingRequirement", "notarizationRequirement",
          "publicationRequirement", "artifactName", "status", "evidence", "limitations"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "product": { "type": "string", "minLength": 1 },
          "platform": { "enum": ["windows", "linux", "macos"] },
          "operatingSystem": { "type": "string" },
          "architecture": { "type": "string" },
          "format": { "enum": ["exe", "zip", "deb", "rpm", "tar.gz", "snap", "dmg"] },
          "installationScope": { "type": "string" },
          "runtimeType": { "type": "string" },
          "buildStrategy": { "type": "string" },
          "buildHostRequirement": { "type": "string" },
          "nativeRunnerRequirement": { "type": "string" },
          "signingRequirement": { "type": "string" },
          "notarizationRequirement": { "type": "string" },
          "publicationRequirement": { "type": "string" },
          "artifactName": { "type": "string", "pattern": "^[^/\\\\]+$" },
          "status": { "type": "string" },
          "evidence": { "type": "array" },
          "limitations": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
