{
    "version": "0.2.0",
    "configurations": [
        

        {
            "type": "node",
            "request": "launch",
            "name": "🟢 Sheikha: Launch Dev (No Cursor)",
            "program": "${workspaceFolder}/server.js",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "NODE_ENV": "development",
                "SECURITY_STRICT_SECRETS": "false",
                "DEBUG": "sheikha:*"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"],
            "outputCapture": "std",
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "🚀 Sheikha: Launch Server (NVIDIA-first)",
            "program": "${workspaceFolder}/server.js",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "AI_MODE": "nvidia",
                "NVIDIA_NIM_PRIORITY": "true",
                "NVIDIA_CUDA_ENABLED": "true",
                "NODE_ENV": "development",
                "DEBUG": "sheikha:*"
            },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"],
            "outputCapture": "std",
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "🐛 Debug: Server with Profiling",
            "program": "${workspaceFolder}/server.js",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "NODE_OPTIONS": "--prof --inspect=9229",
                "NODE_ENV": "development"
            },
            "console": "integratedTerminal",
            "protocol": "inspector"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "🔍 Debug: With Memory Profiling",
            "program": "${workspaceFolder}/server.js",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "NODE_OPTIONS": "--expose-gc --inspect=9229",
                "NODE_ENV": "development"
            },
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "⚡ Development: Watch Mode",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "type": "node",
            "request": "attach",
            "name": "🔗 Attach: to Running Process",
            "port": 9229,
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "python",
            "name": "🐍 Python: Current File",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "type": "python",
            "name": "🧠 Python: Neural Network — AI Cluster",
            "request": "launch",
            "program": "${workspaceFolder}/php-ai-cluster/app.py",
            "module": "uvicorn",
            "args": ["php-ai-cluster.app:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "type": "python",
            "name": "🔬 Python: CUDA / GPU Verify",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/cuda-verify.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "type": "python",
            "name": "🧪 Python: pytest",
            "request": "launch",
            "module": "pytest",
            "args": ["-v", "${workspaceFolder}/tests"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🐘 PHP: Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "log": false,
            "xdebugSettings": {
                "max_children": 256,
                "max_data": 1024,
                "max_depth": 5
            }
        }
    ],
    "compounds": [
        {
            "name": "🎯 Full Stack Debug",
            "configurations": [
                "🚀 Sheikha: Launch Server (NVIDIA-first)",
                "🔗 Attach: to Running Process"
            ]
        }
    ]
}
