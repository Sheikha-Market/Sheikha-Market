# Google Ecosystem Integration - Complete Environment Variables
# منظومة تكامل Google - جميع متغيرات البيئة المطلوبة
# ============================================================

# 🔐 Google OAuth 2.0 - تسجيل الدخول بنقرة واحدة
GOOGLE_CLIENT_ID=CHANGE_ME_google_oauth_client_id_from_console
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_oauth_client_secret_from_console
GOOGLE_REDIRECT_URI=https://sheikha.top/auth/google/callback

# 📁 Google Cloud Storage - تخزين الملفات السحابي
GOOGLE_CLOUD_PROJECT=CHANGE_ME_your_gcp_project_id
GOOGLE_CLOUD_STORAGE_BUCKET=CHANGE_ME_your_storage_bucket_name
GOOGLE_CLOUD_KEY_FILE=service-account.json

# 🔥 Firebase - قاعدة البيانات الفورية والإشعارات
FIREBASE_DATABASE_URI=https://CHANGE_ME_your_project.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_FILE=firebase.json

# 🗺️ Google Maps - الخرائط والموقع الجغرافي
GOOGLE_MAPS_API_KEY=CHANGE_ME_your_google_maps_api_key

# 💳 Google Pay - معالجة الدفع الآمن
GOOGLE_PAY_MERCHANT_ID=CHANGE_ME_your_google_pay_merchant_id
GOOGLE_PAY_MERCHANT_NAME=Sheikha Market
GOOGLE_PAY_PUBLIC_KEY=CHANGE_ME_your_google_pay_public_key
GOOGLE_PAY_ENVIRONMENT=PRODUCTION

# 📊 Google Analytics 4 - التحليلات الشاملة
GA4_MEASUREMENT_ID=CHANGE_ME_your_ga4_measurement_id
GA4_API_SECRET=CHANGE_ME_your_ga4_api_secret
GA4_PROPERTY_ID=CHANGE_ME_your_ga4_property_id
GA4_KEY_FILE=analytics.json

# 👔 Google Workspace - إدارة البريد والمتعاونين
GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@sheikha.top
GOOGLE_WORKSPACE_API_KEY=CHANGE_ME_your_workspace_api_key

# 💰 Stripe (شريك Google Pay)
STRIPE_PUBLIC_KEY=CHANGE_ME_your_stripe_public_key
STRIPE_SECRET_KEY=CHANGE_ME_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=CHANGE_ME_your_stripe_webhook_secret

# 📧 SendGrid (شريك Google Workspace)
SENDGRID_API_KEY=CHANGE_ME_your_sendgrid_api_key

# 🔑 السرية والأمان العام
APP_KEY=base64:CHANGE_ME_generate_new_key_with_php_artisan_key_generate
JWT_SECRET=CHANGE_ME_generate_secure_jwt_secret
API_TOKEN_SECRET=CHANGE_ME_generate_secure_api_token

# 🗂️ مسارات التخزين الحساسة
GCS_CREDENTIALS_PATH=storage/app/google-credentials
FIREBASE_CREDENTIALS_PATH=storage/app/firebase-credentials
GA4_CREDENTIALS_PATH=storage/app/analytics-credentials

# 📝 السجلات والتتبع
LOG_CHANNEL=stack
LOG_LEVEL=debug
GOOGLE_LOG_CHANNEL=single
FIREBASE_LOG_CHANNEL=single
ANALYTICS_LOG_CHANNEL=single
PAYMENT_LOG_CHANNEL=single
FILES_LOG_CHANNEL=single
