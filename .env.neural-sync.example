# Neural sync optional environment configuration
# Copy to .env.neural-sync and fill values for enterprise direct auth.

# Optional: change env file path at runtime
# export NEURAL_SYNC_ENV_FILE=.env.neural-sync

# Optional: override enterprise remote name (default: enterprise)
ENTERPRISE_REMOTE_NAME=enterprise

# Optional: enterprise repo URL via HTTPS
ENTERPRISE_REPO_URL=https://github.com/Sheikha-top/sheikha-enterprise-portal.git

# Enterprise account credentials (required only for direct HTTPS auth)
ENTERPRISE_GIT_USERNAME=your_enterprise_username
ENTERPRISE_GIT_TOKEN=your_fine_grained_token
