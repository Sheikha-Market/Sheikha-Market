#!/usr/bin/env bash
set -e

echo "[SHEIKHA] Governance Verification"

export SHEIKHA_GIT_STATUS_SCOPE=staged
export SHEIKHA_GIT_STATUS_FILE="/tmp/sheikha-staged-status.$$"
SHEIKHA_DELETION_GUARD_FILE="/tmp/sheikha-deletion-guard.$$"
trap 'rm -f "$SHEIKHA_GIT_STATUS_FILE" "$SHEIKHA_DELETION_GUARD_FILE"' EXIT

git diff HEAD --name-status --diff-filter=D > "$SHEIKHA_DELETION_GUARD_FILE"
if [[ -s "$SHEIKHA_DELETION_GUARD_FILE" ]]; then
  echo "[SHEIKHA] BLOCKED: tracked deletions require explicit recovery and review."
  echo "[SHEIKHA] Deletions found (first 50):"
  sed -n '1,50p' "$SHEIKHA_DELETION_GUARD_FILE"
  echo "[SHEIKHA] See docs/canonical/environment/SHEIKHA-DELETION-GOVERNANCE.md"
  exit 1
fi

git status --short --untracked-files=no \
  | awk 'substr($0,1,1) != " " && substr($0,1,1) != "?"' \
  > "$SHEIKHA_GIT_STATUS_FILE"

node tools/governance/runtime-admission-controller.js >/tmp/sheikha-admission.json

if grep -q '"decision": "BLOCKED"' /tmp/sheikha-admission.json; then
  echo "[SHEIKHA] BLOCKED FILES DETECTED"
  exit 1
fi

node tools/governance/runtime-integrity-verifier.js >/tmp/sheikha-integrity.json

echo "[SHEIKHA] Governance Passed"
exit 0
