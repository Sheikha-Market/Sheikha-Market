{
	"folders": [
		{
			"path": ".",
			"name": "SHEIKHA"
		},
		{
			"path": "sheikha-vscode-extension",
			"name": "SHEIKHA Extension"
		}
	],
	"settings": {
		"sheikha.workspaceLocalTools": true,
		"typescript.disableAutomaticTypeAcquisition": true,
		"json.schemaDownload.enable": false,
		"terminal.integrated.env.linux": {
			"PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
		},
		"[javascript]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode",
			"editor.formatOnSave": true,
			"editor.codeActionsOnSave": {}
		},
		"editor.formatOnSave": true,
		"editor.inlineSuggest.enabled": true,
		"editor.inlineSuggest.showToolbar": "onHover",
		"editor.quickSuggestions": {
			"other": true,
			"comments": false,
			"strings": true
		},
		"github.copilot.enable": {
			"*": true,
			"plaintext": false,
			"markdown": false
		},
		"github.copilot.chat.localeOverride": "ar",
		"editor.codeActionsOnSave": {},
		"rome.enable": false
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Sheikha: Local Workspace Verification",
				"type": "process",
				"command": "node",
				"args": ["${workspaceFolder:SHEIKHA}/sheikha-vscode-extension/scripts/verify-workspace-integration.js"],
				"options": { "cwd": "${workspaceFolder:SHEIKHA}" },
				"group": { "kind": "build", "isDefault": true },
				"problemMatcher": []
			},
			{
				"label": "📦 Install Dependencies",
				"type": "shell",
				"command": "npm",
				"args": ["install"],
				"options": { "cwd": "${workspaceFolder:SHEIKHA}" },
				"group": {
					"kind": "build",
					"isDefault": false
				}
			},
			{
				"label": "🚀 Start Development Server",
				"type": "shell",
				"command": "npm",
				"args": ["run", "dev"],
				"options": { "cwd": "${workspaceFolder:SHEIKHA}" },
				"isBackground": true,
				"problemMatcher": {
					"pattern": {
						"regexp": "^.*$",
						"file": 1,
						"location": 2,
						"message": 3
					},
					"background": {
						"activeOnStart": true,
						"beginsPattern": "^.*listening.*",
						"endsPattern": "^.*ready.*"
					}
				}
			},
			{
				"label": "🔧 Run Scripts Check",
				"type": "shell",
				"command": "npm",
				"args": ["run", "ops:readiness"],
				"options": { "cwd": "${workspaceFolder:SHEIKHA}" },
				"group": "test"
			},
			{
				"label": "🎯 Run VSCode Doctor",
				"type": "process",
				"command": "npm",
				"args": ["run", "dev:vscode:doctor"],
				"options": { "cwd": "${workspaceFolder:SHEIKHA}" },
				"group": "test"
			},
			{
				"label": "🟢 Start Dev (No Cursor)",
				"type": "process",
				"command": "npm",
				"args": ["start"],
				"options": { "cwd": "${workspaceFolder:SHEIKHA}", "env": { "NODE_ENV": "development" } },
				"isBackground": true,
				"problemMatcher": []
			},
			{
				"label": "🛡️ Full Secure Activate",
				"options": { "cwd": "${workspaceFolder:SHEIKHA}" },
				"type": "shell",
				"command": "bash",
				"args": [
					"-lc",
					"source \"$HOME/.nvm/nvm.sh\" >/dev/null 2>&1 || true; nvm use 25.6.1 >/dev/null 2>&1 || true; npm run ops:activate:secure"
				],
				"problemMatcher": []
			}
		]
	},
	"extensions": {
		"recommendations": [
			"sheikha.sheikha",
			"hostinger-official.hostinger-connector",
			"GitHub.Copilot",
			"GitHub.Copilot-Chat",
			"eamodio.gitlens",
			"dbaeumer.vscode-eslint",
			"esbenp.prettier-vscode",
			"ms-python.python",
			"ms-python.vscode-pylance",
			"ms-vscode.cpptools",
			"ms-toolsai.jupyter",
			"ms-vscode-remote.remote-ssh",
			"ms-vscode-remote.remote-containers",
			"usernamehw.errorlens",
			"streetsidesoftware.code-spell-checker",
			"aaron-bond.better-comments",
			"sonarsource.sonarlint-vscode",
			"VisualStudioExptTeam.vscodeintellicode"
		],
		"unwantedRecommendations": [
			"anysphere.cursor",
			"cursor.cursor",
			"cursor.cursor-vscode",
			"rome.rome",
			"biomejs.biome"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "🟢 Sheikha: Launch Dev (No Cursor)",
				"type": "node",
				"request": "launch",
				"program": "${workspaceFolder:SHEIKHA}/server.js",
				"cwd": "${workspaceFolder:SHEIKHA}",
				"env": {
					"NODE_ENV": "development"
				},
				"console": "integratedTerminal"
			},
			{
				"name": "🚀 Sheikha: Launch Server (NVIDIA-first)",
				"type": "node",
				"request": "launch",
				"program": "${workspaceFolder:SHEIKHA}/server.js",
				"cwd": "${workspaceFolder:SHEIKHA}",
				"console": "integratedTerminal"
			}
		]
	}
}
