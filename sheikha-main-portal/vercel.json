{
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "builds": [
    {
      "src": "api/sovereign-cloud.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/supreme-64gb.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sheikha-edge-daemon.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/billionaire-magnet.js",
      "use": "@vercel/node"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/sovereign-cloud",
      "dest": "/api/sovereign-cloud.js"
    },
    {
      "src": "/api/supreme-64gb",
      "dest": "/api/supreme-64gb.js"
    },
    {
      "src": "/api/sheikha-edge-daemon",
      "dest": "/api/sheikha-edge-daemon.js"
    },
    {
      "src": "/api/billionaire-magnet",
      "dest": "/api/billionaire-magnet.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
